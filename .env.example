# ── Copy to .env and fill in. Never commit .env. ──

# Access key to unlock the app. Generate a strong one:
#   openssl rand -base64 24
# Access key — NO LONGER USED for authentication. Authentication is handled by
# your upstream reverse proxy (e.g. Authentik forward auth). This value is
# ignored by the app. SECURITY: keep APP_BIND=127.0.0.1 (or firewall the port)
# so the app is only reachable through that proxy, never directly.
APP_TOKEN=unused

# Where the app port is published on the host (your nginx proxies to this).
#   APP_BIND=127.0.0.1  -> loopback only; use when nginx is on THIS host (default)
#   APP_BIND=0.0.0.0    -> reachable on the LAN; use when nginx is on another host
#                          (and firewall the port to just the proxy)
APP_BIND=127.0.0.1
APP_PORT=8000

# Database credentials (app talks to db internally; db is not exposed to host).
POSTGRES_USER=ambush
POSTGRES_PASSWORD=change-me-too
POSTGRES_DB=ambushiq
