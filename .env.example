# ── Copy to .env and fill in. Never commit .env. ──

# Access key to unlock the app. Generate a strong one:
#   openssl rand -base64 24
# NOTE: APP_TOKEN can be left blank (or set to unused) if authentication is handled
# by another process (e.g. Authentik forward auth, Authelia, Cloudflare Access).
# If left blank/unused, the app will automatically disable the access key prompt.
APP_TOKEN=unused

# Where the app port is published on the host (your nginx proxies to this).
#   APP_BIND=127.0.0.1  -> loopback only; use when nginx is on THIS host (default)
#   APP_BIND=0.0.0.0    -> reachable on the LAN; use when nginx is on another host
#                          (and firewall the port to just the proxy)
APP_BIND=127.0.0.1
APP_PORT=8000

# Database credentials (app talks to db internally; db is not exposed to host).
POSTGRES_USER=ambush
POSTGRES_PASSWORD=change-me-too
POSTGRES_DB=ambushiq

# Where trail-camera photos are stored on the HOST (bind-mounted into the
# container at /app/data/camera_images). Relative paths are resolved against
# the directory docker compose runs from.
CAMERA_IMAGE_PATH=./data/camera_images

# Trail-camera species/animal detection.
#   megadetector -> filter synced photos by real animal detection (default; heavier image/build, needs the MegaDetector model download)
#   fallback     -> skip ML entirely; every synced photo is recorded as a sighting
DETECTOR_MODE=megadetector

# Which MegaDetector model DETECTOR_MODE=megadetector loads. Only matters in that mode.
#   MDV5A          -> lighter, well-tested
#   MDV5B          -> alternate v5 weights
#   MDV6-yolov10-c -> heavier, more accurate (default)
DETECTOR_MODEL=MDV6-yolov10-c

# Minimum MegaDetector confidence (0.0-1.0) for a photo to count as an animal
# detection. Lower = more (and more false-positive) sightings; higher = fewer.
DETECTOR_CONF=0.2

# Backend log verbosity.
#   WARNING -> quiet; only warnings/errors (default)
#   INFO    -> adds camera sync diagnostics
#   DEBUG   -> full trace
LOG_LEVEL=WARNING
